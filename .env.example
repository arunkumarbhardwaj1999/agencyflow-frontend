# Local (Next.js rewrite proxy) — use in .env.local:
# NEXT_PUBLIC_API_URL=/api/v1
#
# Production (Railway) — see .env.production
# NEXT_PUBLIC_API_URL=https://agencyflow-backend-production.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public site URL used for sitemap, canonical, Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Sign-In — OAuth 2.0 Web client ID (Google Cloud Console)
# Must match GOOGLE_CLIENT_ID in agencyflow-backend/.env
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
